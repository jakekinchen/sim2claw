{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics:workspace-exchange:v1",
  "title": "Read-only robotics workspace exchange v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_sha256",
    "generated_at",
    "workspace",
    "sources",
    "profiles",
    "capabilities",
    "evidence",
    "permissions",
    "native_gate",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "robotics.workspace_exchange.v1"
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "repository",
        "mandate",
        "owner_task"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "head",
            "branch",
            "dirty"
          ],
          "properties": {
            "head": {
              "type": "string",
              "pattern": "^[0-9a-f]{40,64}$"
            },
            "branch": {
              "type": "string",
              "minLength": 1
            },
            "dirty": {
              "type": "boolean"
            }
          }
        },
        "mandate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "source_priority"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "source_priority": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]*$"
              },
              "minItems": 1,
              "maxItems": 256
            }
          }
        },
        "owner_task": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1,
      "maxItems": 256
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "robot_family",
          "native_schema",
          "scope",
          "action",
          "observation",
          "timing",
          "source_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "robot_family": {
            "type": "string",
            "minLength": 1
          },
          "native_schema": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dimension",
              "ordered_names",
              "units",
              "encoding",
              "representation",
              "transform_policy"
            ],
            "properties": {
              "dimension": {
                "type": "integer",
                "minimum": 1,
                "maximum": 128
              },
              "ordered_names": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "maxItems": 256
              },
              "units": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "maxItems": 256
              },
              "encoding": {
                "type": "string",
                "minLength": 1
              },
              "representation": {
                "type": "string",
                "minLength": 1
              },
              "transform_policy": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "observation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dimension",
              "description",
              "privileged_state_policy"
            ],
            "properties": {
              "dimension": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "privileged_state_policy": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "timing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "control_hz",
              "physics_step_s",
              "clock",
              "frame_policy"
            ],
            "properties": {
              "control_hz": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "physics_step_s": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "clock": {
                "type": "string",
                "minLength": 1
              },
              "frame_policy": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "minItems": 1,
            "maxItems": 256
          }
        }
      },
      "minItems": 1,
      "maxItems": 256
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "native_schema",
          "availability",
          "description",
          "read_only",
          "entrypoint"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "kind": {
            "enum": [
              "workspace",
              "evidence",
              "scene",
              "policy_metadata",
              "diagnostic",
              "lesson",
              "behavior_spec"
            ]
          },
          "native_schema": {
            "type": "string",
            "minLength": 1
          },
          "availability": {
            "enum": [
              "implemented",
              "proposed",
              "unavailable"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "read_only": {
            "const": true
          },
          "entrypoint": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 256
          }
        }
      },
      "minItems": 1,
      "maxItems": 256
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_classes",
        "native_record_schemas",
        "integrity_meaning",
        "acceptance_meaning",
        "records_exported"
      ],
      "properties": {
        "native_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 256
        },
        "native_record_schemas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 256
        },
        "integrity_meaning": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_meaning": {
          "type": "string",
          "minLength": 1
        },
        "records_exported": {
          "const": false
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inspect",
        "execute",
        "mutate_sources",
        "train",
        "hardware",
        "promote",
        "paid_compute"
      ],
      "properties": {
        "inspect": {
          "const": true
        },
        "execute": {
          "const": false
        },
        "mutate_sources": {
          "const": false
        },
        "train": {
          "const": false
        },
        "hardware": {
          "const": false
        },
        "promote": {
          "const": false
        },
        "paid_compute": {
          "const": false
        }
      }
    },
    "native_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "detail"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "refused",
            "source_only",
            "unavailable"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 256
    }
  }
}
