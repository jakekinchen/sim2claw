  "contact_requirements": [
    "Explicit arm/duck/mount/fixture collision pair matrix; never inherit locomotion masks silently.",
    "Keep original baseline assets immutable; author an isolated manipulation variant only after source review.",
    "Characterize collision surfaces, friction and compliance against independent measurements."
  ],
  "unmet_gates": [
    {
      "id": "static_scene",
      "requires": [
        "declaration_check"
      ],
      "acceptance": "One direct SO-101 model, one declared MicroDuck model and fixture compile/render with unique names and explicit solver settings; no training."
    },
    {
      "id": "controller_routing",
      "requires": [
        "static_scene"
      ],
      "acceptance": "Bounded separate action buffers preserve native names, units, rates, home offsets and free-base state; no clipping or cross-actor writes."
    },
    {
      "id": "hardware_measurements",
      "requires": [
        "declaration_check"
      ],
      "acceptance": "Measure existing battery mass/COM/inertia, latch, connector, tolerances, mounting pose and extraction path; no assumed redesign."
    },
    {
      "id": "battery_mechanics",
      "requires": [
        "hardware_measurements",
        "controller_routing"
      ],
      "acceptance": "Separate removable body and reconcile trunk inertia; validate release/retention, grasp, contact and insertion orientation."
    },
    {
      "id": "service_task",
      "requires": [
        "battery_mechanics"
      ],
      "acceptance": "Frozen phase evaluator for stabilization, release, extraction, parking, insertion and latch/connection checks, with negative cases and power continuity state."
    },
    {
      "id": "local_training",
      "requires": [
        "service_task"
      ],
      "acceptance": "Scripted baseline then bounded local Metal/MPS skill training; held-out scenes/seeds and evaluator frozen first."
    },
    {
      "id": "independent_validation",
      "requires": [
        "local_training"
      ],
      "acceptance": "Pinned CPU MuJoCo/float32 evaluator; document residuals and failures. Bounded NVIDIA/Brev only for named local capability gaps."
    }
  ],
  "compute_policy": {
    "default": "local_mac",
    "physics_candidate": "isolated Genesis 1.3.3 Metal shared-scene adapter in existing Apple lane",
    "learner_candidate": "PyTorch MPS",
    "reference_evaluator": "pinned CPU MuJoCo with independently owned float32 policy evaluation",
    "use_active_training_environment_directly": false,
    "benchmark_required_before_backend_selection": true,
    "remote_role": "last_resort_inference_or_validation",
    "remote_provider": "NVIDIA/Brev",
    "remote_training_default": false,
    "remote_launch_authorized_by_plan": false,
    "remote_request_fields": [
      "unresolved_local_gate",
      "exact_checkpoint_and_source_hashes",
      "fixed_cases_and_seeds",
      "instance_identity",
      "maximum_duration",
      "maximum_cost",
      "retained_receipt_paths",
      "stop_or_delete_condition"
    ],
    "shutdown_after_bounded_job": true
  },
  "permissions": {
    "inspect": true,
    "simulate": false,
    "train": false,
    "hardware": false,
    "paid_compute": false,
    "promote": false
  },
  "claim": "A planning and source-binding contract only. No shared scene, battery removability, action execution, physics fidelity, electrical connection or task success is established."
