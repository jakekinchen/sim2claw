  "regions": {
    "board_plus_margin": {
      "source_polygon": "or81_contract.annotations.episodes.points_px",
      "fill": "convex_polygon",
      "dilation_kernel_px": 15
    },
    "outside_board": {
      "definition": "pixelwise_complement_of_board_plus_margin"
    }
  },
  "metric": {
    "edge_detection_domain": "full_frame_before_region_mask",
    "canny_low_threshold": 50,
    "canny_high_threshold": 150,
    "tolerance_dilation_kernel_px": 3,
    "zero_edge_policy": "fail_closed"
  },
  "decision_rule": {
    "select_board_to_robot_world_registration_if": {
      "or82_minus_or81_board_edge_f1_positive_every_episode": true,
      "or82_minus_or81_outside_board_edge_f1_negative_every_episode": true
    },
    "otherwise": "insufficient_region_separation_no_new_fit"
  },
  "resource_boundary": {
