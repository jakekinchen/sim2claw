  "development_selection": {
    "episode_source": "or72_contract.episodes",
    "episode_count": 4,
    "physical_frame_index_each": 0,
    "state_trace_frame_index_each": 0,
    "physical_orientation": "hflip_then_vflip_equivalent_rotate_180_degrees",
    "physical_resize": "full_frame_area_to_search_or_output_resolution",
    "candidate_pixel_source": "shared_3d_scene_and_state_only"
  },
  "camera_family": {
    "parameter_order": ["target_x_m", "target_y_m", "target_z_m", "azimuth_degrees", "elevation_degrees", "distance_m", "vertical_fov_degrees"],
    "bounds": [
      [-0.6, 0.3],
      [0.25, 1.0],
      [0.75, 1.15],
      [-180.0, 180.0],
      [35.0, 85.0],
      [0.7, 2.5],
      [35.0, 95.0]
    ],
    "position_formula": "target_plus_distance_times_cos_elevation_cos_azimuth_cos_elevation_sin_azimuth_sin_elevation",
    "shared_across_all_episodes": true,
    "camera_only": true
  },
  "search": {
    "algorithm": "scipy_differential_evolution",
    "seed": 73,
    "population_size_multiplier": 6,
    "maximum_iterations": 7,
    "tolerance": 0.0,
    "absolute_tolerance": 0.0,
    "polish": false,
    "workers": 1,
    "search_width_px": 160,
    "search_height_px": 120,
    "maximum_candidate_evaluations": 336,
    "objective": "negative_of_0.8_times_mean_tolerant_edge_f1_plus_0.2_times_mean_full_frame_linear_pixel_similarity",
    "edge_weight": 0.8,
    "full_frame_weight": 0.2
  },
  "renderer": {
    "implementation": "or71_host_native_numpy_opencv_cpu_analytic_projection",
    "output_width_px": 320,
    "output_height_px": 240,
    "appearance_transform": "identity_declared_rgba",
    "appearance_fit_allowed": false,
    "mesh_policy": "oriented_box_from_declared_manifest_geom_size",
    "background_rgb": [24, 28, 34]
  },
  "metric": {
    "primary_formula": "1_minus_mean_absolute_bgr_error_divided_by_255",
    "edge": {
      "canny_low_threshold": 50,
      "canny_high_threshold": 150,
      "tolerance_dilation_kernel_px": 3
    }
  },
  "acceptance": {
    "minimum_selected_minus_default_mean_edge_f1": 0.05,
    "minimum_selected_minus_default_mean_full_frame_similarity": 0.0,
    "require_each_episode_objective_not_worse_than_default": true,
    "require_one_shared_vector": true
  },
  "resource_boundary": {
    "development_physical_video_decodes_allowed": 4,
    "development_physical_frames_allowed": 4,
    "development_state_trace_reads_allowed": 4,
